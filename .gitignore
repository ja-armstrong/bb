# Local build artifacts — build Go binaries with: go build -o bin/ ./cmd/bitbeard
/bin/
/bitbeard-linux-*
/bitbeard.exe

# Agent/maintainer workflow files — not part of the shipped project
AGENTS.md
/.scratch/
/node_modules/

# Jellyfin's ./jellyfin mount is live runtime state; only the shipped
# default (logging.default.json) is tracked.
/bitbeard/jellyfin/*
!/bitbeard/jellyfin/logging.default.json
