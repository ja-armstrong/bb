# USER-FACING
# VPN / network
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_PROVIDER=
# USER-FACING
# The custom provider's .ovpn flow: set VPN_PROVIDER=custom and point
# OPENVPN_CUSTOM_CONFIG at the config file as the gluetun container sees
# it (`bitbeard setup` writes /gluetun/openvpn/custom.ovpn, the path your
# openvpn/ directory is mounted at). Any known provider leaves it empty:
# gluetun then runs natively with no .ovpn file at all. An empty-but-set
# value is ignored by gluetun (same as unset), so an empty
# OPENVPN_CUSTOM_CONFIG cannot re-enter custom mode.
OPENVPN_CUSTOM_CONFIG=
# USER-FACING
# Optional server selection for known providers: comma-separated country
# names, as gluetun spells them (see gluetun's server list). Empty =
# gluetun picks a server for you.
SERVER_COUNTRIES=
TZ=
# USER-FACING
# The Admin Panel's VPN page writes its edits into openvpn/vpn.env on this
# same directory (and, in the custom provider's mode, rewrites the server
# lines of openvpn/custom.ovpn); applying them restarts gluetun.
# Provider/credential changes made there need a `docker compose up` to
# reach gluetun's environment, since a container's env is fixed at
# creation — a restart alone re-reads the OpenVPN config file only.

# USER-FACING
# Media servers
PLEX_CLAIM=
# USER-FACING
# Optional Jellyfin provisioning integration (off by default): when
# JELLYFIN_API_TOKEN is set, approving a Registration Request also creates
# the matching Jellyfin user (same username) with a random password the
# user replaces later from the Webui — the password is never shown to
# anyone. The token comes from Jellyfin's Dashboard -> API Keys. The URL
# default is how the api container reaches the host-published 8096 (the
# compose api service carries the host-gateway extra_host for it). The
# integration is on only when both values are set; `bitbeard setup` can
# collect them for you.
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_TOKEN=

# USER-FACING
# Indexers and the torrent client (owned by the Download Manager)
JACKETT_API_KEY=ffgvybxouy2czbjnbem8vir00y4lyvsj
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
BASE_DOWNLOAD_DIR=/media

# Identity and service-to-service auth
# USER-FACING
# Shared bearer token for API <-> Download Manager and manager -> Bot webhook.
# Change this before exposing the stack.
SERVICE_TOKEN=change-me-to-a-long-random-token
# USER-FACING
# Bootstrap Admin seeded by the API on first boot, when no database exists.
# Change the password before first boot.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# USER-FACING
# Global default Storage Quota in GB; Admins are exempt.
DEFAULT_QUOTA_GB=50
# USER-FACING
# How often the Download Manager reconciles Storage Quota against on-disk
# usage, in seconds. The manager defaults to 3600 (hourly) if unset; the
# value is set here so compose does not warn about a blank interpolation.
QUOTA_RECONCILE_INTERVAL=3600
# USER-FACING
# How long a login Session lasts before the API refuses it (hours).
SESSION_TTL_HOURS=24
# USER-FACING
# Single SQLite database on the shared data volume.
DATABASE_PATH=/data/bitbeard.db

# USER-FACING
# Bot Frontend
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCE_CHANNEL_ID=
# USER-FACING
# Where the Bot reaches the API.
API_URL=http://127.0.0.1:9870

# USER-FACING
# Internal hops (all optional; every Subsystem shares gluetun's netns, so
# localhost is the right host). MANAGER_URL: where the API proxies search/
# download/progress/cancel. BOT_URL: where the manager mirrors Completion
# Events. API_URL doubles as where the manager sends Lifecycle Events.
MANAGER_URL=http://127.0.0.1:9871
BOT_URL=http://127.0.0.1:9872

# USER-FACING
# Docker control (ADR-0003): the compose project whose label the API
# filters the docker listing on. Must match the project name docker-compose
# itself uses — only set this if you run the stack under a different name
# or set COMPOSE_PROJECT_NAME on the host.
# COMPOSE_PROJECT_NAME=bitbeard

# USER-FACING: Optional Subsystems to boot — which of the Bot and the Media
# USER-FACING: Servers (plex, jellyfin) run. Empty by default: only the
# USER-FACING: mandatory Subsystems boot. Whichever Optional Subsystems are
# USER-FACING: listed here run; the rest stay absent. Valid profiles: bot,
# USER-FACING: plex, jellyfin.
# COMPOSE_PROFILES=
