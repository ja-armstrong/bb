# VPN / network
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_PROVIDER=
TZ=

# Media servers
PLEX_CLAIM=

# Indexers and the torrent client (owned by the Download Manager)
JACKETT_API_KEY=ffgvybxouy2czbjnbem8vir00y4lyvsj
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
BASE_DOWNLOAD_DIR=/media

# Identity and service-to-service auth
# Shared bearer token for API <-> Download Manager and manager -> Bot webhook.
# Change this before exposing the stack.
SERVICE_TOKEN=change-me-to-a-long-random-token
# Bootstrap Admin seeded by the API on first boot, when no database exists.
# Change the password before first boot.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Global default Storage Quota in GB; Admins are exempt.
DEFAULT_QUOTA_GB=50
# How long a login Session lasts before the API refuses it (hours).
SESSION_TTL_HOURS=24
# Single SQLite database on the shared data volume.
DATABASE_PATH=/data/bitbeard.db

# Bot Frontend
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Where the Bot reaches the API.
API_URL=http://127.0.0.1:9870

# Internal hops (all optional; every Subsystem shares gluetun's netns, so
# localhost is the right host). MANAGER_URL: where the API proxies search/
# download/progress/cancel. BOT_URL: where the manager mirrors Completion
# Events. API_URL doubles as where the manager sends Lifecycle Events.
MANAGER_URL=http://127.0.0.1:9871
BOT_URL=http://127.0.0.1:9872

# Docker control (ADR-0003): the compose project whose label the API
# filters the docker listing on. Must match the project name docker-compose
# itself uses — only set this if you run the stack under a different name
# or set COMPOSE_PROJECT_NAME on the host.
# COMPOSE_PROJECT_NAME=bitbeard
